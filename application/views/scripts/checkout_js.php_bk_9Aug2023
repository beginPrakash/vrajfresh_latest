function ManageShipingAddressBox(obj) {
    if (obj.checked) {
        $("#ship_to_different_address").val('Yes');
        $("#shipingAddressBox").show();
    } else {
        $("#ship_to_different_address").val('No');
        $("#shipingAddressBox").hide();
    }
}
	
	
